#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load meshmanager
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get role main role controller
	[ "$role" = controller ] && /etc/meshmanager/setup-http.sh >/dev/null 2>&1
	procd_open_instance
	if [ "$role" = agent ]; then
		procd_set_param command /etc/meshmanager/agent.sh loop
	else
		procd_set_param command /etc/meshmanager/controller.sh loop
	fi
	procd_set_param respawn 5 5 0
	procd_close_instance
}

service_triggers() { procd_add_reload_trigger meshmanager; }
