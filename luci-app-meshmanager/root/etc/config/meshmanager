config global 'main'
	option enabled '1'
	option role 'controller'
	option controller_ip ''
	option controller_port '17891'
	option node_name 'OpenWrt-Node'
	option token 'change-me-now'
	option heartbeat '5'
	option offline_timeout '15'
	option auto_sync '1'
	option managed_agent '1'
	option config_version '1'

config wifi 'wifi24'
	option enabled '1'
	option sync '1'
	option ssid 'MyHome_24G'
	option encryption 'sae-mixed'
	option key '12345678'
	option channel 'auto'
	option htmode 'HE20'
	option txpower ''

config wifi 'wifi5'
	option enabled '1'
	option sync '1'
	option ssid 'MyHome_5G'
	option encryption 'sae-mixed'
	option key '12345678'
	option channel 'auto'
	option htmode 'HE80'
	option txpower ''

config roaming 'roaming'
	option enabled '1'
	option ieee80211r '1'
	option ieee80211k '1'
	option ieee80211v '1'
	option mobility_domain '4f57'
	option ft_over_ds '0'

config smart_roaming 'smart'
	option enabled '1'
	option roaming_rssi '-67'
	option critical_rssi '-75'
	option min_dwell '10'
	option cooldown '15'
	option prefer_5g '1'
	option prevent_pingpong '1'
	option bss_transition '1'
	option force_disconnect '0'
	option apply_24 '1'
	option apply_5 '1'

config mesh 'backhaul'
	option enabled '1'
	option mode 'hybrid'
	option mesh_id 'OpenWrt-Mesh'
	option key 'meshpassword'
	option band '5g'
	option channel '149'
	option htmode 'HE80'
	option reconnect '1'
