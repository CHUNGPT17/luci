#!/bin/sh

. /lib/functions.sh

RUNDIR=/tmp/wanpolicy
STATUS_JSON="$RUNDIR/status.json"
mkdir -p "$RUNDIR"

log() {
	local line="$(date '+%Y-%m-%d %H:%M:%S') $*"
	logger -t wanpolicy "$*"
	echo "$line" >> "$RUNDIR/wanpolicy.log"
	if [ "$(wc -l < "$RUNDIR/wanpolicy.log" 2>/dev/null)" -gt 400 ]; then
		tail -n 250 "$RUNDIR/wanpolicy.log" > "$RUNDIR/wanpolicy.log.tmp" && mv "$RUNDIR/wanpolicy.log.tmp" "$RUNDIR/wanpolicy.log"
	fi
}

safe_name() {
	echo "$1" | tr -c 'A-Za-z0-9_-' '_'
}

iface_up() {
	local ifn="$1"
	[ -n "$ifn" ] || return 1
	local out
	out="$(ubus call "network.interface.$ifn" status 2>/dev/null)" || return 1
	echo "$out" | jsonfilter -e '@.up' 2>/dev/null | grep -qx 'true'
}

iface_device() {
	local ifn="$1"
	ubus call "network.interface.$ifn" status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null
}

watchdog_match_cb() {
	local sec="$1" enabled wif
	config_get_bool enabled "$sec" enabled 1
	[ "$enabled" -eq 1 ] || return
	config_get wif "$sec" interface
	[ "$wif" = "$HEALTH_IFACE" ] && FOUND_WATCHDOG=1
}

watchdog_health_for_iface() {
	local ifn="$1" s
	s="$(safe_name "$ifn")"
	HEALTH_IFACE="$ifn"
	FOUND_WATCHDOG=0
	config_foreach watchdog_match_cb watchdog
	if [ "$FOUND_WATCHDOG" -eq 1 ] && [ -f "$RUNDIR/if_${s}.health" ]; then
		cat "$RUNDIR/if_${s}.health"
		return
	fi
	if iface_up "$ifn"; then
		echo healthy
	else
		echo unhealthy
	fi
}

join_domains_cb() {
	[ -n "$1" ] || return
	if [ -z "$DOMAIN_JOINED" ]; then
		DOMAIN_JOINED="$1"
	else
		DOMAIN_JOINED="$DOMAIN_JOINED $1"
	fi
}

policy_sync_one() {
	local sec="$1" enabled name primary backup proto psec current desired health
	config_get_bool enabled "$sec" enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get name "$sec" name "$sec"
	config_get primary "$sec" primary
	config_get backup "$sec" backup
	config_get proto "$sec" proto all
	[ -n "$primary" ] || return 0
	[ -n "$backup" ] || backup="$primary"

	health="$(watchdog_health_for_iface "$primary")"
	if [ "$health" = "healthy" ]; then
		desired="$primary"
	else
		desired="$backup"
	fi

	psec="wp_$(safe_name "$sec")"
	DOMAIN_JOINED=""
	config_list_foreach "$sec" domain join_domains_cb
	[ -n "$DOMAIN_JOINED" ] || return 0
	echo "$psec" >> "$RUNDIR/desired_pbr_sections"

	# Keep an app-owned PBR policy in sync with the LuCI configuration.
	uci -q batch <<EOT
set pbr.$psec=policy
set pbr.$psec.name='WANPolicy: $name'
set pbr.$psec.enabled='1'
set pbr.$psec.interface='$desired'
set pbr.$psec.proto='$proto'
set pbr.$psec.dest_addr='$DOMAIN_JOINED'
EOT

	current="$(cat "$RUNDIR/policy_$(safe_name "$sec").iface" 2>/dev/null)"
	local signature old_signature
	signature="$desired|$proto|$DOMAIN_JOINED"
	old_signature="$(cat "$RUNDIR/policy_$(safe_name "$sec").signature" 2>/dev/null)"
	if [ "$current" != "$desired" ] || [ "$old_signature" != "$signature" ]; then
		echo "$desired" > "$RUNDIR/policy_$(safe_name "$sec").iface"
		echo "$signature" > "$RUNDIR/policy_$(safe_name "$sec").signature"
		echo "$health" > "$RUNDIR/policy_$(safe_name "$sec").primary_health"
		POLICY_CHANGED=1
		log "policy '$name': $current -> $desired (primary $primary is $health)"
	fi
}

sync_policies() {
	local global_enabled resolver strict
	config_load wanpolicy
	config_get_bool global_enabled global enabled 1
	if [ "$global_enabled" -ne 1 ]; then
		local stale removed=0
		for stale in $(uci -q show pbr | sed -n "s/^pbr\.\(wp_[A-Za-z0-9_-]*\)=policy$/\1/p"); do
			uci -q delete "pbr.$stale" && removed=1
		done
		if [ "$removed" -eq 1 ]; then
			uci commit pbr
			/etc/init.d/pbr reload >/dev/null 2>&1 || true
		fi
		return 0
	fi
	config_get resolver global pbr_resolver_set dnsmasq.nftset
	config_get strict global strict_enforcement 0

	local global_sig old_global_sig
	global_sig="1|$resolver|$strict"
	old_global_sig="$(cat "$RUNDIR/pbr_global.signature" 2>/dev/null)"
	uci -q batch <<EOT
set pbr.config.enabled='1'
set pbr.config.resolver_set='$resolver'
set pbr.config.strict_enforcement='$strict'
EOT

	POLICY_CHANGED=0
	if [ "$global_sig" != "$old_global_sig" ]; then
		echo "$global_sig" > "$RUNDIR/pbr_global.signature"
		POLICY_CHANGED=1
	fi
	: > "$RUNDIR/desired_pbr_sections"
	config_foreach policy_sync_one policy

	# Remove app-owned PBR sections when a LuCI policy is disabled or deleted.
	for stale in $(uci -q show pbr | sed -n "s/^pbr\.\(wp_[A-Za-z0-9_-]*\)=policy$/\1/p"); do
		if ! grep -qx "$stale" "$RUNDIR/desired_pbr_sections" 2>/dev/null; then
			uci -q delete "pbr.$stale"
			POLICY_CHANGED=1
			log "removed stale PBR policy $stale"
		fi
	done

	if [ "$POLICY_CHANGED" -eq 1 ]; then
		uci commit pbr
		/etc/init.d/pbr reload >/dev/null 2>&1 || /etc/init.d/pbr restart >/dev/null 2>&1
	fi
}

ping_target_cb() {
	local target="$1"
	[ "$PING_OK" -eq 1 ] && return
	[ -n "$target" ] || return
	if ping -I "$WD_DEVICE" -c 1 -W "$WD_TIMEOUT" "$target" >/dev/null 2>&1; then
		PING_OK=1
	fi
}

watchdog_one() {
	local sec="$1" enabled name ifn interval failures timeout restart_delay recovery_wait
	local safe now last due failcount recover_until
	config_get_bool enabled "$sec" enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get name "$sec" name "$sec"
	config_get ifn "$sec" interface
	[ -n "$ifn" ] || return 0
	config_get interval "$sec" interval 10
	config_get failures "$sec" failures 3
	config_get timeout "$sec" timeout 2
	config_get restart_delay "$sec" restart_delay 2
	config_get recovery_wait "$sec" recovery_wait 20

	safe="$(safe_name "$sec")"
	now="$(date +%s)"
	last="$(cat "$RUNDIR/wd_${safe}.last" 2>/dev/null)"
	case "$last" in ''|*[!0-9]*) last=0;; esac
	due=$((last + interval))
	[ "$now" -ge "$due" ] || return 0
	echo "$now" > "$RUNDIR/wd_${safe}.last"

	recover_until="$(cat "$RUNDIR/wd_${safe}.recover_until" 2>/dev/null)"
	case "$recover_until" in ''|*[!0-9]*) recover_until=0;; esac
	if [ "$now" -lt "$recover_until" ]; then
		echo unhealthy > "$RUNDIR/if_$(safe_name "$ifn").health"
		return 0
	fi

	WD_DEVICE="$(iface_device "$ifn")"
	if [ -z "$WD_DEVICE" ]; then
		PING_OK=0
	else
		WD_TIMEOUT="$timeout"
		PING_OK=0
		config_list_foreach "$sec" target ping_target_cb
	fi

	failcount="$(cat "$RUNDIR/wd_${safe}.fails" 2>/dev/null)"
	case "$failcount" in ''|*[!0-9]*) failcount=0;; esac

	if [ "$PING_OK" -eq 1 ]; then
		[ "$failcount" -gt 0 ] && log "watchdog '$name': recovered on $ifn"
		echo 0 > "$RUNDIR/wd_${safe}.fails"
		echo healthy > "$RUNDIR/if_$(safe_name "$ifn").health"
		echo "$(date +%s)" > "$RUNDIR/wd_${safe}.last_success"
		return 0
	fi

	failcount=$((failcount + 1))
	echo "$failcount" > "$RUNDIR/wd_${safe}.fails"
	echo "$(date +%s)" > "$RUNDIR/wd_${safe}.last_failure"
	log "watchdog '$name': ping failed $failcount/$failures on $ifn"

	if [ "$failcount" -lt "$failures" ]; then
		# Do not declare the WAN dead before the configured failure threshold.
		return 0
	fi

	echo unhealthy > "$RUNDIR/if_$(safe_name "$ifn").health"
	# Switch affected domain policies to their backup before restarting the interface.
	sync_policies

	log "watchdog '$name': restarting interface $ifn after $failcount consecutive failures"
	echo "$(date +%s)" > "$RUNDIR/wd_${safe}.last_restart"
	ubus call "network.interface.$ifn" down '{}' >/dev/null 2>&1
	sleep "$restart_delay"
	ubus call "network.interface.$ifn" up '{}' >/dev/null 2>&1
	echo 0 > "$RUNDIR/wd_${safe}.fails"
	echo $(( $(date +%s) + recovery_wait )) > "$RUNDIR/wd_${safe}.recover_until"
}

json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

write_status() {
	local first=1 sec enabled name ifn safe fails health last_restart primary backup selected phealth
	local tmp="$STATUS_JSON.tmp"
	config_load wanpolicy
	{
		echo '{'
		echo '  "watchdogs": ['
		status_watchdog_emit() {
			local sec="$1"
			config_get_bool enabled "$sec" enabled 1
			[ "$enabled" -eq 1 ] || return
			config_get name "$sec" name "$sec"
			config_get ifn "$sec" interface
			safe="$(safe_name "$sec")"
			fails="$(cat "$RUNDIR/wd_${safe}.fails" 2>/dev/null)"; [ -n "$fails" ] || fails=0
			health="$(watchdog_health_for_iface "$ifn")"
			last_restart="$(cat "$RUNDIR/wd_${safe}.last_restart" 2>/dev/null)"; [ -n "$last_restart" ] || last_restart=0
			[ "$first" -eq 1 ] || echo ','
			first=0
			printf '    {"section":"%s","name":"%s","interface":"%s","health":"%s","fails":%s,"last_restart":%s}' \
				"$(json_escape "$sec")" "$(json_escape "$name")" "$(json_escape "$ifn")" "$(json_escape "$health")" "$fails" "$last_restart"
		}
		config_foreach status_watchdog_emit watchdog
		echo
		echo '  ],'
		echo '  "policies": ['
		first=1
		status_policy_emit() {
			local sec="$1"
			config_get_bool enabled "$sec" enabled 1
			[ "$enabled" -eq 1 ] || return
			config_get name "$sec" name "$sec"
			config_get primary "$sec" primary
			config_get backup "$sec" backup
			selected="$(cat "$RUNDIR/policy_$(safe_name "$sec").iface" 2>/dev/null)"; [ -n "$selected" ] || selected="$primary"
			phealth="$(watchdog_health_for_iface "$primary")"
			[ "$first" -eq 1 ] || echo ','
			first=0
			printf '    {"section":"%s","name":"%s","primary":"%s","backup":"%s","selected":"%s","primary_health":"%s"}' \
				"$(json_escape "$sec")" "$(json_escape "$name")" "$(json_escape "$primary")" "$(json_escape "$backup")" "$(json_escape "$selected")" "$(json_escape "$phealth")"
		}
		config_foreach status_policy_emit policy
		echo
		echo '  ]'
		echo '}'
	} > "$tmp"
	mv "$tmp" "$STATUS_JSON"
}

cleanup_generated_pbr() {
	# Remove stale app-owned sections whose source policy no longer exists/enabled.
	local sec psec wpsec src enabled
	for wpsec in $(uci -q show pbr | sed -n "s/^pbr\.\(wp_[A-Za-z0-9_-]*\)=policy$/\1/p"); do
		src="${wpsec#wp_}"
		# Exact reverse mapping is not possible after sanitizing; leave section unless rebuilt.
		# Stale entries can be cleared by /etc/init.d/wanpolicy reset-pbr if desired.
		:
	done
}

# Initial sync
config_load wanpolicy
sync_policies
write_status

while true; do
	config_load wanpolicy
	config_foreach watchdog_one watchdog
	sync_policies
	write_status
	sleep 2
done
