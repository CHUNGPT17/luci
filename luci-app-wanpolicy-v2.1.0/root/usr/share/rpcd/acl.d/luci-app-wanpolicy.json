{
  "luci-app-wanpolicy": {
    "description": "Grant access to WAN Policy configuration and status",
    "read": {
      "uci": [
        "wanpolicy",
        "network",
        "pbr"
      ],
      "ubus": {
        "network.interface": [
          "dump"
        ],
        "network.interface.*": [
          "status"
        ]
      },
      "file": {
        "/tmp/wanpolicy/status.json": [
          "read"
        ],
        "/tmp/wanpolicy/wanpolicy.log": [
          "read"
        ]
      }
    },
    "write": {
      "uci": [
        "wanpolicy"
      ]
    }
  }
}
